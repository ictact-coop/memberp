DATABASE_URL="postgresql://memberp:memberp@localhost:5432/memberp?schema=public"

# Prisma CLI(마이그레이션 등)가 쓰는 직접 연결 주소. Supabase처럼 DATABASE_URL이
# 커넥션 풀러를 가리키는 배포에서만 실제로 다른 값이 필요하다 — 풀러의 트랜잭션
# 모드는 마이그레이션이 쓰는 장기 세션·advisory lock을 지원하지 않기 때문이다
# ("Vercel 배포(Supabase)" 절 참고). 로컬·Docker처럼 풀러 없이 Postgres에 바로
# 붙는 경우는 DATABASE_URL과 같은 값으로 두면 된다.
DIRECT_URL="postgresql://memberp:memberp@localhost:5432/memberp?schema=public"

# 로그인 링크·초대 링크를 만들 때 쓰는 절대 주소 (마지막 슬래시 없이)
APP_BASE_URL="http://localhost:3000"

# ADR-0003: Resend API 키. 비워두면 실제로 발송하지 않고 콘솔에 링크를 출력한다(로컬 개발용).
RESEND_API_KEY=""
EMAIL_FROM="공동체IT <login@example.org>"

# ADR-0002: TOTP 비밀키 암호화 키. base64로 인코딩된 32바이트 값이어야 한다.
# 생성 예: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=""

# ADR-0004: 첨부파일 저장 방식. "local"(기본값, 비워둬도 됨) 또는 "s3".
# Vercel 등 서버리스 환경에서는 로컬 디스크가 요청마다 사라질 수 있으므로
# "local"을 쓰면 안 된다 — 반드시 "s3"로 설정하고 아래 ATTACHMENT_S3_* 값을
# 채운다("Vercel 배포" 절 참고).
ATTACHMENT_STORAGE_DRIVER=""

# driver=local일 때만 쓴다. 비워두면 <프로젝트 루트>/storage/attachments.
ATTACHMENT_STORAGE_DIR=""

# driver=s3일 때만 쓴다. S3와 호환되는 MinIO 등 자체 호스팅 서비스도 이 설정으로
# 그대로 쓸 수 있다 — 그런 서비스는 ATTACHMENT_S3_ENDPOINT를 채우고
# ATTACHMENT_S3_FORCE_PATH_STYLE을 "true"로 둔다(버추얼호스트 스타일 URL을
# 지원하지 않는 경우가 많다). 자격 증명은 AWS SDK 기본 규칙을 따른다 — 아래
# 두 값을 채우거나, 비워두고 배포 환경의 IAM 역할·자격 증명 파일 등을 쓴다.
ATTACHMENT_S3_BUCKET=""
ATTACHMENT_S3_REGION=""
ATTACHMENT_S3_ENDPOINT=""
ATTACHMENT_S3_FORCE_PATH_STYLE=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
